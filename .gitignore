# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Playwright QA auth snapshots (session tokens — never commit)
/tests/qa/.auth/

# Playwright run artifacts
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# Cursor MCP local credentials (use .cursor/mcp.json.example as template)
.cursor/mcp.json

# Local dev accounting login (copy dev-local-login.config.example.json)
src/lib/accounting/dev-local-login.config.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# QA 임시 로그인 저장 파일(토큰 포함)은 올리지 않는다
/tests/qa/tmp-*auth-storage*.json
tests/qa/_output/
