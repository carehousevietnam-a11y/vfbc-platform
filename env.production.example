# VFBCAI Platform - VPS Docker production environment template
#
# Usage:
#   cp env.production.example .env.production
#   (fill values, then: docker compose --env-file .env.production up -d --build)
#
# NEXT_PUBLIC_* and RESEND_API_KEY must be available at `docker compose build` time.
# Runtime secrets are read from this file (or `--env-file`) at container start.
#
# Supabase Dashboard -> Authentication -> URL Configuration (required)
#   Site URL: https://YOUR_DOMAIN
#   Redirect URLs:
#     https://YOUR_DOMAIN/admin/auth/callback
#     https://YOUR_DOMAIN/login
#     https://YOUR_DOMAIN/admin/reset-password

NEXT_PUBLIC_SITE_URL=https://YOUR_DOMAIN

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=

RESEND_API_KEY=
RESEND_FROM_EMAIL=VFBCAI <noreply@YOUR_DOMAIN>

LEGAL_RAG_URL=http://legal-rag:8080
LEGAL_RAG_INTERNAL_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
