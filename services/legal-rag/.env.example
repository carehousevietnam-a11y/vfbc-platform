# services/legal-rag 환경변수 예시
# 실제 .env 파일은 절대 커밋하지 않는다 (VFBCAI 개발 원칙: 보안정보 노출 금지)

# Hugging Face 접근 토큰 (비공개 데이터셋이 아니므로 필수는 아니나, rate limit 완화용)
HF_TOKEN=

# 다운로드 시 고정할 revision (Architecture.md 4장 참고, 임의 변경 금지)
VBPL_VN_REVISION=11c902856b7a389788853fdd39b4998a5effa490
VIETNAMESE_LEGAL_DOCS_REVISION=0a39ad7eae8e6c188cb225c4b1443c3b346461d8

# 이 프로젝트 전용 PostgreSQL (STEP2 이후 사용, 기존 Supabase와 별도)
# LEGAL_RAG_DATABASE_URL=

# STEP5-3 OpenAI RAG Connector — 반드시 환경변수로만 제공(코드에 하드코딩 금지).
# 둘 중 하나라도 비어있으면 Connector는 OpenAI를 호출하지 않고
# status=configuration_error를 반환한다.
OPENAI_API_KEY=
OPENAI_MODEL=
LEGAL_RAG_TRANSLATION_MODEL=gpt-4o-mini

# STEP14~16 Production API/Transport (src/production/config.py, src/transport/server.py 기준)
# 비어있으면 /ready가 503과 함께 "LEGAL_RAG_INTERNAL_TOKEN is not configured"를 반환한다.
# /review 호출 시 X-VFBCAI-Internal-Token 헤더 값과 hmac.compare_digest로 비교된다.
LEGAL_RAG_INTERNAL_TOKEN=

# WSGI 서버 바인딩 주소/포트 (기본값: 127.0.0.1 / 8080)
LEGAL_RAG_HOST=
LEGAL_RAG_PORT=

# 요청 본문 최대 크기(바이트, 기본값: 1048576 = 1MB, 최대 10485760)
LEGAL_RAG_MAX_BODY_BYTES=

# CORS Access-Control-Allow-Origin 값 (비워두면 CORS 헤더 자체를 붙이지 않음)
LEGAL_RAG_ALLOW_ORIGIN=

# OpenAI 호출 재시도 횟수(기본값: 2, 허용 범위 1~5)
LEGAL_RAG_RETRY_ATTEMPTS=

# 재시도 간 대기 시간(초, 기본값: 0.25, 허용 범위 0~30)
LEGAL_RAG_RETRY_DELAY_SECONDS=
