# VFBCAI Legal RAG - VPS Docker production environment template
#
# Usage:
#   cp env.production.example .env.production
#
# LEGAL_RAG_INTERNAL_TOKEN must match the root .env.production value.
# Corpus files must exist under data/corpus/pilot_10000/ before starting
# (see scripts/install-pilot-corpus.sh and docs/DOCKER-DEPLOY.md).

LEGAL_RAG_HOST=0.0.0.0
LEGAL_RAG_PORT=8080
LEGAL_RAG_MAX_BODY_BYTES=1048576

LEGAL_RAG_INTERNAL_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

OPENAI_API_KEY=
OPENAI_MODEL=

# STEP 2 pilot corpus (8,327 docs) — mounted from host via docker-compose volume
LEGAL_RAG_DOCUMENTS_PATH=data/corpus/pilot_10000/documents.jsonl
LEGAL_RAG_CHUNKS_PATH=data/corpus/pilot_10000/chunks.jsonl
LEGAL_RAG_RELATIONSHIPS_PATH=data/corpus/pilot_10000/internal_relations.jsonl

LEGAL_RAG_RETRY_ATTEMPTS=2
LEGAL_RAG_RETRY_DELAY_SECONDS=0.25
LEGAL_RAG_LOG_LEVEL=INFO
